<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
	<name>Only If 'Tolerance' Below in Drug Policy</name>
	<author>SeoHyeon</author>
	<packageId>seohyeon.onlyIfToleranceBelow</packageId>
	<supportedVersions>
		<li>1.4</li>
		<li>1.5</li>
		<li>1.6</li>
		<li>1.7</li>
	</supportedVersions>
	<description>
		This mod adds a slide bar in Drug Policy. If it sets below 'Any', The colonist will take the drug only if their tolerance level of the drug's chemical below this threshold.
	</description>
